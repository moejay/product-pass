{
  "manifest_version": 3,
  "name": "Product Pass",
  "version": "0.5.0",
  "description": "Capture visual website feedback, organize it into issue drafts, and publish approved issues to GitHub.",
  "homepage_url": "https://moejay.github.io/product-pass/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Product Pass", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidebar/index.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
